{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.qrabiye.com.tr" }],
      "destination": "https://qrabiye.com.tr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.agrolives.com.tr" }],
      "destination": "https://agrolives.com.tr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.onlinefidan.com.tr" }],
      "destination": "https://onlinefidan.com.tr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.isinhazir.com.tr" }],
      "destination": "https://isinhazir.com.tr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.bizetciyiz.com.tr" }],
      "destination": "https://bizetciyiz.com.tr/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "qrabiye.com.tr" }],
      "destination": "/qrabiye/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "agrolives.com.tr" }],
      "destination": "/agrolives/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "onlinefidan.com.tr" }],
      "destination": "/onlinefidan/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "isinhazir.com.tr" }],
      "destination": "/isinhazir/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bizetciyiz.com.tr" }],
      "destination": "/bizetciyiz/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
